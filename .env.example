# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key      # never expose publicly

# ── Groq (AI summarization + classification) ─────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key

# ── LibreTranslate ───────────────────────────────────────────────────
# Use https://libretranslate.com (free with key) OR self-host on Render
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_KEY=your-libretranslate-api-key  # leave empty if self-hosted

# ── Resend (email delivery) ──────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=digest@yourdomain.com         # must be a verified Resend sender
RESEND_FROM_NAME=Music Digest

# ── App settings ─────────────────────────────────────────────────────
APP_BASE_URL=https://your-project.vercel.app    # used for unsubscribe links
LOG_LEVEL=INFO
DRY_RUN=false                                   # set true to skip DB writes & emails
MAX_ARTICLES_PER_SOURCE=20                      # cap per crawl run
MIN_ARTICLE_TEXT_LENGTH=200                     # skip articles shorter than this
